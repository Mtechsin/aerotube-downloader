<?xml version="1.0" encoding="utf-8"?>
<!-- Data extraction rules for Android 12+ (API 31+) cloud backup/device transfer.
     Excludes sensitive download history and auth-related shared preferences from
     backup; allows non-sensitive app data to be restored. -->
<data-extraction-rules>
    <cloud-backup>
        <!-- Exclude the Hive database files that store download history
             (may contain URLs of downloaded content). -->
        <exclude domain="file" path="appdata/" />
        <exclude domain="file" path="flutter_appdata/" />

        <!-- Exclude shared prefs that hold auth flags and tokens. -->
        <exclude domain="sharedpref" path="FlutterSecureStorage.xml" />
        <exclude domain="sharedpref" path="flutter." />
    </cloud-backup>

    <!-- Device-to-device transfer (D2D): same exclusions. -->
    <device-transfer>
        <exclude domain="file" path="appdata/" />
        <exclude domain="file" path="flutter_appdata/" />
        <exclude domain="sharedpref" path="FlutterSecureStorage.xml" />
        <exclude domain="sharedpref" path="flutter." />
    </device-transfer>
</data-extraction-rules>
